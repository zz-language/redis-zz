import std.time

import redis

func main() -> Result<int, redis.RError> {
    c := redis.connect("redis://127.0.0.1:6379")?
    t0 := time.now_ms()
    i := 0
    while i < 200 {
        _u9 := c.ping()?
        i = i + 1
    }
    ms := time.now_ms() - t0
    ops := 0
    if ms > 0 {
        ops = 200 * 1000 / ms
    }
    println("ping ops=200 ms={ms} ops_per_s={ops}")
    _u1 := c.close()
    .ok(0)
}
