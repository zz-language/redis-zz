@test
func live_mget_with_miss() {
    _u9 := match live_dial() {
        .ok(c) => live_mget_body(c)
        .err(e) => live_skip_kind("mget", e)
    }
}

func live_mget_body(c: client.Client) -> int {
    bad := 0
    ka := live_key("mget", "a")
    km := live_key("mget", "missing")
    match c.set(ka, "va", 0) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL set {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match c.mget([ka, km]) {
        .ok(vs) => {
            bad = bad + live_mget_check(vs, "va")
        }
        .err(e) => {
            println("FAIL mget {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match c.del([ka]) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL del {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    _u1 := c.close()
    assert(bad == 0)
    bad
}

func live_mget_check(vs: [Option<str>], want: str) -> int {
    bad := 0
    if vs.len() != 2 {
        println("FAIL mget len {vs.len()}")
        return bad + 1
    }
    match vs[0] {
        .some(s) => {
            if s != want {
                println("FAIL mget[0] want {want} got {s}")
                bad = bad + 1
            }
        }
        .none => {
            println("FAIL mget[0] want hit")
            bad = bad + 1
        }
    }
    match vs[1] {
        .some(s) => {
            println("FAIL mget[1] want miss got {s}")
            bad = bad + 1
        }
        .none => {
            bad = live_noop_ok(bad)
        }
    }
    bad
}

@test
func live_wrong_password_is_auth() {
    _u9 := match url.parse(live_url_raw()) {
        .ok(o) => live_badpass_run(o)
        .err(e) => {
            println("FAIL url {e.kind}")
            assert(false)
            0
        }
    }
}

func live_badpass_run(o: url.Options) -> int {
    o.pass = "zz-wrong-pass"
    o.connect_ms = 500
    match client.connect_with(o) {
        .ok(c) => {
            println("FAIL want auth rejection")
            _u1 := client.close(c)
            assert(false)
            1
        }
        .err(e) => live_badpass_kind(e)
    }
}

func live_badpass_kind(e: errors.RError) -> int {
    if e.kind == "conn_refused" {
        println("SKIP wrong_password: no live server")
        return 0
    }
    if e.kind != "auth" {
        println("FAIL want auth got {e.kind} {e.detail}")
        assert(false)
        return 1
    }
    0
}

@test
func live_nosuchcmd_is_redis_error() {
    _u9 := match live_dial() {
        .ok(c) => live_nosuch_body(c)
        .err(e) => live_skip_kind("nosuchcmd", e)
    }
}

func live_nosuch_body(c: client.Client) -> int {
    bad := 0
    match c.do("NOSUCHCMD", []) {
        .ok(_) => {
            println("FAIL want error for NOSUCHCMD")
            bad = bad + 1
        }
        .err(e) => {
            bad = bad + live_kind_is(e, "redis", "NOSUCHCMD")
        }
    }
    _u1 := c.close()
    assert(bad == 0)
    bad
}

func live_kind_is(e: errors.RError, want: str, what: str) -> int {
    if e.kind != want {
        println("FAIL {what} want {want} got {e.kind} {e.detail}")
        return 1
    }
    0
}

@test
func live_wrongtype_is_redis_error() {
    _u9 := match live_dial() {
        .ok(c) => live_wrongtype_body(c)
        .err(e) => live_skip_kind("wrongtype", e)
    }
}

func live_wrongtype_body(c: client.Client) -> int {
    bad := 0
    k := live_key("wt", "list")
    match c.del([k]) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL del {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match c.do("LPUSH", [k, "a"]) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL lpush {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match c.get(k) {
        .ok(_) => {
            println("FAIL want WRONGTYPE for GET on list")
            bad = bad + 1
        }
        .err(e) => {
            bad = bad + live_kind_is(e, "redis", "wrongtype")
            if str.contains(e.detail, "WRONGTYPE") == false {
                println("FAIL detail {e.detail}")
                bad = bad + 1
            }
        }
    }
    match c.del([k]) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL del {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    _u1 := c.close()
    assert(bad == 0)
    bad
}

@test
func live_db_isolation() {
    _u9 := match url.parse(live_url_raw()) {
        .ok(o) => live_db_run(o)
        .err(e) => {
            println("FAIL url {e.kind}")
            assert(false)
            0
        }
    }
}

// A key written in db B is invisible in db A (and vice versa).

func live_db_run(o: url.Options) -> int {
    bad := 0
    b := o.db + 1
    if b > 15 {
        b = 0
    }
    ob := o
    ob.db = b
    ob.connect_ms = 500
    ob.read_ms = 5000
    ob.write_ms = 5000
    oa := o
    oa.connect_ms = 500
    oa.read_ms = 5000
    oa.write_ms = 5000
    match client.connect_with(ob) {
        .ok(cb) => {
            match client.connect_with(oa) {
                .ok(ca) => {
                    bad = bad + live_db_check(ca, cb, b)
                }
                .err(e) => {
                    _u2 := client.close(cb)
                    bad = bad + live_skip_or_fail("db_isolation A", e)
                }
            }
        }
        .err(e) => {
            bad = bad + live_skip_or_fail("db_isolation B", e)
        }
    }
    assert(bad == 0)
    bad
}

func live_skip_or_fail(what: str, e: errors.RError) -> int {
    if e.kind == "conn_refused" {
        println("SKIP {what}: no live server")
        return 0
    }
    println("FAIL {what} dial {e.kind} {e.detail}")
    1
}

func live_db_check(ca: client.Client, cb: client.Client, b: int) -> int {
    bad := 0
    k := live_key("dbiso", "k")
    match cb.set(k, "in-b", 0) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL set B {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match ca.get(k) {
        .ok(v) => {
            match v {
                .some(s) => {
                    println("FAIL db leak: A saw {s} (B={b})")
                    bad = bad + 1
                }
                .none => {
                    bad = live_noop_ok(bad)
                }
            }
        }
        .err(e) => {
            println("FAIL get A {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match cb.get(k) {
        .ok(v) => {
            bad = bad + live_sgd_got(v, "in-b")
        }
        .err(e) => {
            println("FAIL get B {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    match cb.del([k]) {
        .ok(_) => {
            bad = live_noop_ok(bad)
        }
        .err(e) => {
            println("FAIL del B {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    _u1 := ca.close()
    _u2 := cb.close()
    bad
}

@test
func live_redacted_hides_password() {
    assert(cmds.version() != "")
    match url.parse("redis://alice:s3cret-pw@127.0.0.1:6379/0") {
        .ok(o) => {
            r := url.redacted(o)
            assert(str.contains(r, "***"))
            assert(str.contains(r, "s3cret-pw") == false)
            assert(str.contains(r, "alice"))
        }
        .err(e) => {
            println("FAIL url {e.kind}")
            assert(false)
        }
    }
}
