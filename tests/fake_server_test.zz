// +PONG one byte at a time: framing reassembles, reply stays exact.

func fake_loris_run(port: int, ch: process) -> int {
    bad := 0
    if fx_poll(port, 90) != 0 {
        println("FAIL server never listened")
        bad = bad + 1
    }
    match fx_dial(port) {
        .ok(c) => {
            bad = bad + fake_loris_check(c)
        }
        .err(e) => {
            println("FAIL dial {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    rep := fx_reap(ch)
    bad = fx_check_report(rep, "code=0", bad)
    bad = fx_check_report(rep, "FSRVDONE", bad)
    assert(bad == 0)
    bad
}

func fake_loris_check(c: client.Client) -> int {
    match client.exchange(c, ["PING"], true, 0) {
        .ok(r) => fake_loris_value(c, r)
        .err(e) => {
            println("FAIL exchange {e.kind} {e.detail}")
            1
        }
    }
}

func fake_loris_value(c: client.Client, r: conn.Reply) -> int {
    match resp.as_str(r.arena, conn.reply_value(r)) {
        .ok(s) => fake_loris_str(c, s)
        .err(e) => {
            println("FAIL as_str {e.kind}")
            1
        }
    }
}

func fake_loris_str(c: client.Client, s: str) -> int {
    bad := 0
    if s != "PONG" {
        println("FAIL want PONG got {s}")
        bad = bad + 1
    }
    _u1 := client.close(c)
    bad
}
