func fake_map_value(c: client.Client, r: conn.Reply) -> int {
    bad := 0
    if resp.tag_of(r.arena, conn.reply_value(r)) != resp.R_MAP {
        println("FAIL want map tag")
        bad = bad + 1
    }
    match resp.as_map(r.arena, conn.reply_value(r)) {
        .ok(flat) => fake_map_flat(c, r.arena, flat, bad)
        .err(e) => {
            println("FAIL as_map {e.kind}")
            bad + 1
        }
    }
}

func fake_map_flat(c: client.Client, a: resp.Arena, flat: [resp.Value], bad: int) -> int {
    nb := bad
    if flat.len() != 2 {
        println("FAIL want 2 map entries")
        nb = bad + 1
    }
    match resp.as_str(a, flat[0]) {
        .ok(k) => fake_map_kv(c, a, flat, k, nb)
        .err(e) => {
            println("FAIL as_str {e.kind}")
            nb + 1
        }
    }
}

func fake_map_kv(c: client.Client, a: resp.Arena, flat: [resp.Value], k: str, bad: int) -> int {
    nb := bad
    if k != "a" {
        println("FAIL want key a got {k}")
        nb = bad + 1
    }
    match resp.as_str(a, flat[1]) {
        .ok(v) => fake_map_v(c, v, nb)
        .err(e) => {
            println("FAIL as_str {e.kind}")
            nb + 1
        }
    }
}

func fake_map_v(c: client.Client, v: str, bad: int) -> int {
    nb := bad
    if v != "b" {
        println("FAIL want value b got {v}")
        nb = bad + 1
    }
    _u1 := client.close(c)
    nb
}

