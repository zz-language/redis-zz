// fake_server_test.zz — scripted RESP over loopback TCP, no redis server.
//
// Each test spawns tests/helpers/fsrv.zz as a CHILD PROCESS (single-exit
// pattern: every failure is counted, the child is always reaped, one final
// assert). The child answers the client handshake (two CLIENT SETINFO get
// +OK) plus scripted command replies; the parent drives the REAL client
// single-threaded and then asserts on the reply AND the child's stdout
// report lines.
//
// Why processes and not task.spawn + std.chan: in-process scripted servers
// flaked ~50% per round-trip on this toolchain (interpreter shell-pool
// race, RefCell panics in env.rs under concurrent net IO), while the
// child-process shape is 10/10 deterministic. See the plan §14.2 layer 2;
// the layer's cases are all covered, only the transport differs.
//
// Reply SPEC directives (fsrv "fake" mode): a plain RESP payload is written
// verbatim, "SEND_CLOSE:<payload>" writes then closes (short reads),
// "SPLIT:n:<payload>" drip-feeds n bytes at a time with 5ms sleeps, and
// "CLOSE" closes without replying.
//
// Ports are pid/token-derived (fx_port) so parallel runners never share
// them. Client timeouts are generous (3s) so parallel-compile load can
// never fire them spuriously; every dial uses retries=0 (except the
// redial-leg cases, which have none here) so IO failures surface with
// their first kind instead of redialing into refused.
import std.env
import std.net
import std.process
import std.str
import std.time

import redis.client as client
import redis.conn as conn
import redis.errors as errors
import redis.resp as resp
import redis.url as url

// ---- Child-process harness ----

func fx_zz() -> str {
    "/home/zaid/.cargo/bin/zz"
}

func fx_srv() -> str {
    cwd := env.cwd() ?? "."
    "{cwd}/tests/helpers/fsrv.zz"
}

// Loopback port for test idx. Tests run as separate OS processes with
// (near-)sequential pids, so a plain pid()+idx scheme collides
// systematically; instead each pid owns a 32-wide lane and idx (<32)
// picks within it. Distinct pids land 32+ apart, so ports are unique
// across concurrent tests; the sweep token (run-global) only adds skew.

func fx_port(idx: int) -> int {
    sweep_tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
    tok_num := int(str.replace(sweep_tok, "t", "")) ?? 0
    34000 + (process.pid() % 500) * 32 + tok_num % 32 + idx
}

func fx_spawn(args: [str]) -> Result<process, str> {
    argv := ["run", fx_srv()]
    for a in args {
        argv = argv.push(a)
    }
    process.spawn(fx_zz(), argv)
}

// Raw-connect readiness poll: waits for the child to listen (up to ~18s),
// then closes without sending (the child's tolerated probe session).
// Returns 0 when ready, -1 on exhaustion.

func fx_poll(port: int, tries: int) -> int {
    if tries <= 0 {
        return 0 - 1
    }
    match net.tcp_connect("127.0.0.1:{port}", 300) {
        .ok(raw) => fx_poll_hit(raw)
        .err(_) => fx_poll_miss(port, tries)
    }
}

func fx_poll_hit(raw: tcp.stream) -> int {
    _u1 := raw.close()
    0
}

func fx_poll_miss(port: int, tries: int) -> int {
    time.sleep_ms(200)
    fx_poll(port, tries - 1)
}

// Dial the fake server with generous timeouts and no retries: the first
// error kind is the assertion target, never a redial artifact.

func fx_dial(port: int) -> Result<client.Client, errors.RError> {
    match url.parse("redis://127.0.0.1:{port}?connect_timeout_ms=1000&timeout_ms=3000&retries=0") {
        .ok(o) => client.connect_with(o)
        .err(e) => .err(e)
    }
}

// Reap the child into one "code=N out=..." string for contains-asserts.

func fx_reap(ch: process) -> str {
    match process.wait(ch) {
        .ok(t) => fx_reap_ok(t)
        .err(e) => "code=-1 out=WAITFAIL {e}"
    }
}

func fx_reap_ok(t: [int | str | str]) -> str {
    "code={t[0]} out={t[1]}"
}

func fx_check_report(rep: str, want: str, bad: int) -> int {
    if str.contains(rep, want) == false {
        println("FAIL report missing {want}: {rep}")
        return bad + 1
    }
    bad
}

// ---- Cases (single-exit: count, reap, then assert) ----

@test
func fake_dollar_neg1_is_none() {
    port := fx_port(1)
    _u9 := match fx_spawn(["fake", "{port}", "$-1\r\n"]) {
        .ok(ch) => fake_dollar_neg1_run(port, ch)
        .err(e) => {
            println("FAIL spawn {e}")
            assert(false)
            0
        }
    }
}

// $-1 is a cache miss: a value (None), never an error.

func fake_dollar_neg1_run(port: int, ch: process) -> int {
    bad := 0
    if fx_poll(port, 90) != 0 {
        println("FAIL server never listened")
        bad = bad + 1
    }
    match fx_dial(port) {
        .ok(c) => {
            bad = bad + fake_dollar_neg1_check(c)
        }
        .err(e) => {
            println("FAIL dial {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    rep := fx_reap(ch)
    bad = fx_check_report(rep, "code=0", bad)
    bad = fx_check_report(rep, "FSRVDONE", bad)
    assert(bad == 0)
    bad
}

func fake_dollar_neg1_check(c: client.Client) -> int {
    match client.exchange(c, ["GET", "k"], true, 0) {
        .ok(r) => fake_dollar_neg1_value(c, r)
        .err(e) => {
            println("FAIL exchange {e.kind} {e.detail}")
            1
        }
    }
}

func fake_dollar_neg1_value(c: client.Client, r: conn.Reply) -> int {
    bad := 0
    if resp.is_null(r.arena, conn.reply_value(r)) == false {
        println("FAIL want null")
        bad = bad + 1
    }
    _u1 := client.close(c)
    bad
}

