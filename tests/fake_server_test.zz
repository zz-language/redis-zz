// RESP3 push on a plain connection: protocol unexpected_push, never a value.

func fake_push_run(port: int, ch: process) -> int {
    bad := 0
    if fx_poll(port, 90) != 0 {
        println("FAIL server never listened")
        bad = bad + 1
    }
    match fx_dial(port) {
        .ok(c) => {
            bad = bad + fake_push_check(c)
        }
        .err(e) => {
            println("FAIL dial {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    rep := fx_reap(ch)
    bad = fx_check_report(rep, "code=0", bad)
    bad = fx_check_report(rep, "FSRVDONE", bad)
    assert(bad == 0)
    bad
}

func fake_push_check(c: client.Client) -> int {
    match client.exchange(c, ["PING"], true, 0) {
        .ok(_) => {
            println("FAIL want error for push")
            _u1 := client.close(c)
            1
        }
        .err(e) => fake_push_kind(c, e)
    }
}

func fake_push_kind(c: client.Client, e: errors.RError) -> int {
    bad := 0
    if e.kind != "protocol" {
        println("FAIL want protocol got {e.kind}")
        bad = bad + 1
    }
    if str.contains(e.detail, "unexpected_push") == false {
        println("FAIL detail {e.detail}")
        bad = bad + 1
    }
    _u1 := client.close(c)
    bad
}

