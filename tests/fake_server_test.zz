// One connection, three sequential commands: set, bool, double.

func fake_sbd_run(port: int, ch: process) -> int {
    bad := 0
    if fx_poll(port, 90) != 0 {
        println("FAIL server never listened")
        bad = bad + 1
    }
    match fx_dial(port) {
        .ok(c) => {
            bad = bad + fake_sbd_set(c)
        }
        .err(e) => {
            println("FAIL dial {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    rep := fx_reap(ch)
    bad = fx_check_report(rep, "code=0", bad)
    bad = fx_check_report(rep, "FSRVDONE", bad)
    assert(bad == 0)
    bad
}

func fake_sbd_set(c: client.Client) -> int {
    match client.exchange(c, ["SMEMBERS", "s"], true, 0) {
        .ok(r) => fake_sbd_set_value(c, r)
        .err(e) => {
            println("FAIL set exchange {e.kind} {e.detail}")
            1
        }
    }
}

func fake_sbd_set_value(c: client.Client, r: conn.Reply) -> int {
    bad := 0
    if resp.tag_of(r.arena, conn.reply_value(r)) != resp.R_SET {
        println("FAIL want set tag")
        bad = bad + 1
    }
    match resp.as_array(r.arena, conn.reply_value(r)) {
        .ok(kids) => fake_sbd_set_kids(c, r.arena, kids, bad)
        .err(e) => {
            println("FAIL as_array {e.kind}")
            bad + 1
        }
    }
}

func fake_sbd_set_kids(c: client.Client, a: resp.Arena, kids: [resp.Value], bad: int) -> int {
    nb := bad
    if kids.len() != 1 {
        println("FAIL want 1 member")
        nb = bad + 1
    }
    match resp.as_str(a, kids[0]) {
        .ok(s) => fake_sbd_set_next(c, s, nb)
        .err(e) => {
            println("FAIL as_str {e.kind}")
            nb + 1
        }
    }
}

func fake_sbd_set_next(c: client.Client, s: str, bad: int) -> int {
    nb := bad
    if s != "a" {
        println("FAIL want member a got {s}")
        nb = bad + 1
    }
    nb + fake_sbd_bool(c)
}

func fake_sbd_bool(c: client.Client) -> int {
    match client.exchange(c, ["GET", "b"], true, 0) {
        .ok(r) => fake_sbd_bool_value(c, r)
        .err(e) => {
            println("FAIL bool exchange {e.kind} {e.detail}")
            1
        }
    }
}

func fake_sbd_bool_value(c: client.Client, r: conn.Reply) -> int {
    bad := 0
    if resp.tag_of(r.arena, conn.reply_value(r)) != resp.R_BOOL {
        println("FAIL want bool tag")
        bad = bad + 1
    }
    match resp.as_int(r.arena, conn.reply_value(r)) {
        .ok(n) => fake_sbd_bool_next(c, n, bad)
        .err(e) => {
            println("FAIL as_int {e.kind}")
            bad + 1
        }
    }
}

func fake_sbd_bool_next(c: client.Client, n: int, bad: int) -> int {
    nb := bad
    if n != 1 {
        println("FAIL want true(1) got {n}")
        nb = bad + 1
    }
    nb + fake_sbd_double(c)
}

func fake_sbd_double(c: client.Client) -> int {
    match client.exchange(c, ["GET", "d"], true, 0) {
        .ok(r) => fake_sbd_double_value(c, r)
        .err(e) => {
            println("FAIL double exchange {e.kind} {e.detail}")
            1
        }
    }
}

func fake_sbd_double_value(c: client.Client, r: conn.Reply) -> int {
    bad := 0
    if resp.tag_of(r.arena, conn.reply_value(r)) != resp.R_DOUBLE {
        println("FAIL want double tag")
        bad = bad + 1
    }
    _u1 := client.close(c)
    bad
}

