func fake_nested_check(c: client.Client) -> int {
    match client.exchange(c, ["EXEC"], true, 0) {
        .ok(r) => fake_nested_value(c, r)
        .err(e) => {
            println("FAIL exchange {e.kind} {e.detail}")
