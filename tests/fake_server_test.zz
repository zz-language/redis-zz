// Truncated line framing: the server answers the PING with zero bytes and
// closes. (A partial line plus EOF still completes: the transport returns
// the bytes it has and the parser normalizes one line, so only a zero-byte
// close fails the line read.) The read fails closed, never a half reply.

func fake_short_crlf_run(port: int, ch: process) -> int {
    bad := 0
    if fx_poll(port, 90) != 0 {
        println("FAIL server never listened")
        bad = bad + 1
    }
    match fx_dial(port) {
        .ok(c) => {
            bad = bad + fake_short_crlf_check(c)
        }
        .err(e) => {
            println("FAIL dial {e.kind} {e.detail}")
            bad = bad + 1
        }
    }
    rep := fx_reap(ch)
    bad = fx_check_report(rep, "code=0", bad)
    bad = fx_check_report(rep, "FSRVDONE", bad)
    assert(bad == 0)
    bad
}

func fake_short_crlf_check(c: client.Client) -> int {
    match client.exchange(c, ["PING"], true, 0) {
        .ok(_) => {
            println("FAIL want error for short crlf")
            _u1 := client.close(c)
            1
        }
        .err(e) => fake_short_crlf_kind(c, e)
