        }
    }
}

func fake_nested_value(c: client.Client, r: conn.Reply) -> int {
    match resp.as_array(r.arena, conn.reply_value(r)) {
        .ok(kids) => fake_nested_kids(c, r.arena, kids)
        .err(e) => {
            println("FAIL as_array {e.kind}")
            1
        }
    }
}

func fake_nested_kids(c: client.Client, a: resp.Arena, kids: [resp.Value]) -> int {
    bad := 0
    if kids.len() != 2 {
        println("FAIL want 2 kids")
        bad = bad + 1
    }
    match resp.as_array(a, kids[0]) {
        .ok(inner) => fake_nested_inner(c, a, kids, inner, bad)
        .err(e) => {
            println("FAIL inner as_array {e.kind}")
            bad + 1
        }
    }
}

func fake_nested_inner(c: client.Client, a: resp.Arena, kids: [resp.Value], inner: [resp.Value], bad: int) -> int {
    nb := bad
    if inner.len() != 2 {
        println("FAIL want 2 inner")
        nb = bad + 1
    }
    match resp.as_str(a, inner[1]) {
        .ok(s) => fake_nested_tail(c, a, kids, s, nb)
        .err(e) => {
            println("FAIL as_str {e.kind}")
            nb + 1
        }
    }
}

func fake_nested_tail(c: client.Client, a: resp.Arena, kids: [resp.Value], s: str, bad: int) -> int {
    nb := bad
    if s != "b" {
        println("FAIL want b got {s}")
        nb = bad + 1
    }
    match resp.as_array(a, kids[1]) {
        .ok(empty) => fake_nested_empty(c, empty, nb)
        .err(e) => {
            println("FAIL tail as_array {e.kind}")
            nb + 1
        }
    }
}

func fake_nested_empty(c: client.Client, empty: [resp.Value], bad: int) -> int {
    nb := bad
    if empty.len() != 0 {
        println("FAIL want empty tail")
        nb = bad + 1
    }
    _u1 := client.close(c)
    nb
}

